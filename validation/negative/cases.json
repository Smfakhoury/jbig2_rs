{
  "schema_version": 1,
  "cases": [
    {
      "id": "NEG-PUBLIC-READER-FAILURE",
      "surface": "bounded reader acquisition",
      "expected": "preserved typed I/O error and no sink calls, including after a complete valid input prefix",
      "tests": [
        {"target": "public_api", "name": "reader_errors_remain_typed_and_never_call_the_sink"},
        {"target": "public_api", "name": "complete_page_prefix_does_not_hide_a_late_reader_error"}
      ]
    },
    {
      "id": "NEG-PUBLIC-SINK-FAILURE",
      "surface": "page sink",
      "expected": "exact sink failure returned after one callback; subsequent independent decode still succeeds",
      "tests": [
        {"target": "public_api", "name": "sink_failure_is_preserved_and_does_not_poison_the_decoder"}
      ]
    },
    {
      "id": "NEG-PUBLIC-STREAM-BYTE-LIMIT",
      "surface": "slice and bounded reader input",
      "expected": "inclusive limit accepts exact input size and rejects one byte less",
      "tests": [
        {"target": "public_api", "name": "stream_byte_limit_is_inclusive_for_slice_and_reader_apis"}
      ]
    },
    {
      "id": "NEG-TRUNCATE-STANDALONE-EVERY-BYTE",
      "surface": "document envelope",
      "expected": "typed malformed error except the valid sequential prefix without optional EOF",
      "tests": [
        {"target": "catalog_contracts", "name": "every_standalone_prefix_is_malformed_or_the_exact_optional_eof_prefix"}
      ]
    },
    {
      "id": "NEG-SEGMENT-RESERVED-TYPE",
      "surface": "segment header",
      "expected": "MalformedError::ReservedSegmentType",
      "tests": [
        {"target": "lib", "name": "segment_header::tests::every_flag_byte_has_exact_type_page_and_deferred_fields"}
      ]
    },
    {
      "id": "NEG-HEADER-RETENTION-UNUSED-BITS",
      "surface": "short and long retention fields under the explicit 7.2.4 field policy",
      "expected": "MalformedError::NonZeroUnusedRetentionFlags; worked-example inconsistency remains documented",
      "tests": [
        {"target": "lib", "name": "segment_header::tests::every_short_count_byte_obeys_count_and_unused_bit_rules"},
        {"target": "lib", "name": "segment_header::tests::unused_long_retention_bits_validate_only_the_last_byte"}
      ]
    },
    {
      "id": "NEG-HEADER-EVERY-BYTE-TRUNCATION",
      "surface": "generated segment header fields",
      "expected": "typed UnexpectedEof with exact reader offset and remaining-byte values",
      "tests": [
        {"target": "lib", "name": "segment_header::tests::every_generated_header_prefix_is_a_typed_truncation"}
      ]
    },
    {
      "id": "NEG-HEADER-REFERENCE-BUDGET",
      "surface": "long reference counts",
      "expected": "ReferencesPerSegment limit failure before retention/reference payload acquisition or allocation",
      "tests": [
        {"target": "lib", "name": "segment_header::tests::generated_reference_limits_fail_before_reading_references"}
      ]
    },
    {
      "id": "NEG-SEGMENT-DUPLICATE-NUMBER",
      "surface": "reference graph",
      "expected": "DuplicateSegmentNumber for a globals/page collision; NonIncreasingSegmentNumber for repeated local wire numbers",
      "tests": [
        {"target": "catalog_contracts", "name": "global_page_number_collision_is_an_exact_duplicate_error"},
        {"target": "catalog_contracts", "name": "duplicate_local_wire_numbers_have_exact_order_errors"}
      ]
    },
    {
      "id": "NEG-REFERENCE-MISSING",
      "surface": "reference graph",
      "expected": "MalformedError::MissingReferredSegment",
      "tests": [
        {"target": "catalog_contracts", "name": "missing_reference_has_exact_segment_and_referred_numbers"}
      ]
    },
    {
      "id": "NEG-REFERENCE-DEPTH",
      "surface": "reference graph",
      "expected": "LimitKind::ReferenceDepth",
      "tests": [
        {"target": "lib", "name": "document::tests::enforces_total_reference_and_depth_limits"}
      ]
    },
    {
      "id": "NEG-RETENTION-PREMATURE",
      "surface": "retained segment state",
      "expected": "MalformedError::InvalidRetentionFlags",
      "tests": [
        {"target": "lib", "name": "document::tests::rejects_reference_to_nonretained_segment"}
      ]
    },
    {
      "id": "NEG-PAGE-DIMENSION-BOMB",
      "surface": "bitmap allocation",
      "expected": "LimitKind::Width, Height, PagePixels, or Memory",
      "tests": [
        {"target": "public_api", "name": "page_dimensions_and_structural_work_limits_are_inclusive"},
        {"target": "lib", "name": "bitmap::tests::checked_layout_enforces_each_bitmap_limit"}
      ]
    },
    {
      "id": "NEG-ARITHMETIC-TRUNCATED-BYTEIN",
      "surface": "arithmetic decoder",
      "expected": "MalformedError::UnexpectedEof",
      "tests": [
        {"target": "lib", "name": "arithmetic::tests::initialization_and_byte_in_reject_truncation"},
        {"target": "lib", "name": "arithmetic::tests::marker_fill_requires_a_real_marker"}
      ]
    },
    {
      "id": "NEG-HUFFMAN-OVERSUBSCRIBED",
      "surface": "custom Huffman table",
      "expected": "HuffmanErrorKind::Oversubscribed",
      "tests": [
        {"target": "lib", "name": "huffman::tests::rejects_oversubscribed_and_structurally_invalid_tables"}
      ]
    },
    {
      "id": "NEG-MMR-EXTENSION",
      "surface": "MMR",
      "expected": "MmrErrorKind::ExtensionMode",
      "tests": [
        {"target": "lib", "name": "mmr::tests::extension_mode_is_rejected"}
      ]
    },
    {
      "id": "NEG-MMR-RUN-OVERSHOOT",
      "surface": "MMR",
      "expected": "MmrErrorKind::RunExceedsRow",
      "tests": [
        {"target": "lib", "name": "mmr::tests::run_overshoot_is_rejected"}
      ]
    },
    {
      "id": "NEG-GENERIC-BAD-AT",
      "surface": "generic arithmetic context",
      "expected": "GenericRegionErrorKind::InvalidAdaptivePixel",
      "tests": [
        {"target": "lib", "name": "generic_region::tests::rejects_reserved_flags_mmr_template_and_future_at"}
      ]
    },
    {
      "id": "NEG-HALFTONE-PATTERN-ID",
      "surface": "halftone",
      "expected": "HalftoneErrorKind::InvalidPatternIndex",
      "tests": [
        {"target": "lib", "name": "halftone::tests::rejects_unused_gray_code_and_work_overrun"}
      ]
    },
    {
      "id": "NEG-STRIPE-SEALED-WRITE",
      "surface": "page composition",
      "expected": "MalformedError::InvalidPageState",
      "tests": [
        {"target": "lib", "name": "decode::tests::rejects_region_that_modifies_a_sealed_stripe"}
      ]
    }
  ]
}
