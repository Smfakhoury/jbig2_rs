{
  "schema_version": 1,
  "cases": [
    {
      "id": "NEG-PUBLIC-READER-FAILURE",
      "surface": "bounded reader acquisition",
      "expected": "preserved typed I/O error and no sink calls, including after a complete valid input prefix",
      "tests": [
        {"target": "public_api", "name": "reader_errors_remain_typed_and_never_call_the_sink"},
        {"target": "public_api", "name": "complete_page_prefix_does_not_hide_a_late_reader_error"}
      ]
    },
    {
      "id": "NEG-PUBLIC-SINK-FAILURE",
      "surface": "page sink",
      "expected": "exact sink failure returned after one callback; subsequent independent decode still succeeds",
      "tests": [
        {"target": "public_api", "name": "sink_failure_is_preserved_and_does_not_poison_the_decoder"}
      ]
    },
    {
      "id": "NEG-PUBLIC-STREAM-BYTE-LIMIT",
      "surface": "slice and bounded reader input",
      "expected": "inclusive limit accepts exact input size and rejects one byte less",
      "tests": [
        {"target": "public_api", "name": "stream_byte_limit_is_inclusive_for_slice_and_reader_apis"}
      ]
    },
    {
      "id": "NEG-TRUNCATE-STANDALONE-EVERY-BYTE",
      "surface": "document envelope",
      "expected": "typed malformed error except the valid sequential prefix without optional EOF",
      "coverage": "src/document.rs unit test"
    },
    {
      "id": "NEG-SEGMENT-RESERVED-TYPE",
      "surface": "segment header",
      "expected": "MalformedError::ReservedSegmentType",
      "coverage": "src/segment_header.rs"
    },
    {
      "id": "NEG-SEGMENT-DUPLICATE-NUMBER",
      "surface": "reference graph",
      "expected": "MalformedError::DuplicateSegmentNumber",
      "coverage": "src/document.rs"
    },
    {
      "id": "NEG-REFERENCE-MISSING",
      "surface": "reference graph",
      "expected": "MalformedError::MissingReferredSegment",
      "coverage": "src/document.rs"
    },
    {
      "id": "NEG-REFERENCE-DEPTH",
      "surface": "reference graph",
      "expected": "LimitKind::ReferenceDepth",
      "coverage": "src/document.rs unit test"
    },
    {
      "id": "NEG-RETENTION-PREMATURE",
      "surface": "retained segment state",
      "expected": "MalformedError::InvalidRetentionFlags",
      "coverage": "src/document.rs unit test"
    },
    {
      "id": "NEG-PAGE-DIMENSION-BOMB",
      "surface": "bitmap allocation",
      "expected": "LimitKind::Width, Height, PagePixels, or Memory",
      "coverage": "src/bitmap.rs and src/segment_data.rs"
    },
    {
      "id": "NEG-ARITHMETIC-TRUNCATED-BYTEIN",
      "surface": "arithmetic decoder",
      "expected": "MalformedError::UnexpectedEof",
      "coverage": "src/arithmetic.rs unit test"
    },
    {
      "id": "NEG-HUFFMAN-OVERSUBSCRIBED",
      "surface": "custom Huffman table",
      "expected": "HuffmanErrorKind::Oversubscribed",
      "coverage": "src/huffman.rs unit test"
    },
    {
      "id": "NEG-MMR-EXTENSION",
      "surface": "MMR",
      "expected": "MmrErrorKind::ExtensionMode",
      "coverage": "src/mmr.rs unit test"
    },
    {
      "id": "NEG-MMR-RUN-OVERSHOOT",
      "surface": "MMR",
      "expected": "MmrErrorKind::RunExceedsRow",
      "coverage": "src/mmr.rs unit test"
    },
    {
      "id": "NEG-GENERIC-BAD-AT",
      "surface": "generic arithmetic context",
      "expected": "GenericRegionErrorKind::InvalidAdaptivePixel",
      "coverage": "src/generic_region.rs unit test"
    },
    {
      "id": "NEG-HALFTONE-PATTERN-ID",
      "surface": "halftone",
      "expected": "HalftoneErrorKind::InvalidPatternIndex",
      "coverage": "src/halftone.rs unit test"
    },
    {
      "id": "NEG-STRIPE-SEALED-WRITE",
      "surface": "page composition",
