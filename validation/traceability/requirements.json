        {
          "target": "spec_header",
          "name": "page_count_field_is_unsigned_and_most_significant_first"
        }
      ],
      "strength": "functional_contract",
      "review": "provisional",
      "scope_of_formal_result": "The 16- and 32-bit primitive postconditions specify byte shifts and cursor advancement directly.",
      "assumptions": [
        "Cursor validity is established by construction/prior reads; other field widths require their own mappings."
