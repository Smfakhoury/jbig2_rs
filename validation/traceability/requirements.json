        },
        {
          "target": "lib",
          "name": "reader::tests::failed_bit_read_preserves_position"
        }
      ],
      "strength": "functional_contract",
      "review": "provisional",
      "scope_of_formal_result": "Successful bounded reads equal the recursive bit-value model and advance by the requested count; errors preserve the cursor.",
      "assumptions": [
        "Reader cursor is within input; input length is representable in bits; the model's extraction order is a reviewed translation of 5.4.1."
      ],
      "gaps": [],
      "functional_evidence": [
        {
          "runtime": "reader::BitReader::read_bits",
          "section": "ensures",
          "tokens": [
            "value as nat == crate::spec::readers::bits_value(",
            "final(self).bit_position == old(self).bit_position + count"
          ]
        }
      ],
      "invariant_evidence": []
    },
