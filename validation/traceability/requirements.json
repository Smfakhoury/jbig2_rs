  "requirements": [
    {
      "id": "T88-BITS-MSB-FIRST",
      "standard": "ITU-T T.88 (08/2018)",
      "clause": "5.4.1",
      "title": "Read packed bits from the high bit of each byte before advancing to the next byte",
      "feature": "decoder",
      "runtime": [
        "reader::BitReader::read_bits"
      ],
      "models": [
        "bit-value"
      ],
      "proof_macros": [
        "bits-before",
        "bits-after"
