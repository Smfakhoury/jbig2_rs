{
  "schema_version": 1,
  "cases": [
    {
      "id": "META-PUBLIC-READER-CHUNKS",
      "transformation": "slice input to reader chunks of 1, 3, or 8192 bytes and owned output to page sink",
      "invariant": "document information, page order, dimensions, and exact bitmap bytes",
      "tests": [
        {"target": "public_api", "name": "short_reads_preserve_inspection_decode_and_sink_output"}
      ]
    },
    {
      "id": "META-PUBLIC-CONTEXT-RECOVERY",
      "transformation": "stateless inspection to reusable context, with failed calls interleaved",
      "invariant": "identical metadata and valid reusable globals after errors",
      "tests": [
        {"target": "public_api", "name": "context_inspection_and_globals_recover_after_errors"}
      ]
    },
    {
      "id": "META-ORGANIZATION-EQUIVALENCE",
      "transformation": "sequential to random-access organization",
      "invariant": "decoded page dimensions and bitmap bytes",
      "coverage": "src/decode.rs::sequential_and_random_access_outputs_match"
    },
    {
      "id": "META-REPEAT-DETERMINISM",
      "transformation": "decode identical bytes twice",
      "invariant": "DocumentInfo and error classification",
      "coverage": "src/document.rs::document_inspection_is_deterministic"
    },
    {
      "id": "META-BYTE-READER",
      "transformation": "failed oversized read followed by exact read",
      "invariant": "failed read preserves cursor",
      "coverage": "src/reader.rs"
    },
    {
      "id": "META-COMBINATION-IDENTITIES",
      "transformation": "Boolean inputs across all operators",
      "invariant": "OR/AND/XOR/XNOR/REPLACE truth tables",
      "coverage": "src/bitmap.rs"
    },
    {
      "id": "META-STREAMING-COLLECTION",
      "transformation": "owned output to page-sink output",
      "invariant": "page count and bitmap bytes",
      "coverage": "src/decode.rs"
    }
  ]
}
