    },
    {
      "id": "PERF-GENERIC-MMR-PIXELS",
      "feature": "MMR generic region",
      "scale_by": ["width", "height", "run transitions"],
      "metrics": ["wall_time", "work_units", "allocations", "peak_bytes"]
